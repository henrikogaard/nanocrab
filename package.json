{
  "name": "nanocrab",
  "version": "2.0.0-rc.8",
  "description": "NanoCrab — standalone personal AI assistant platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && rm -rf dist/admin/public && cp -r src/admin/public dist/admin/public",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mock:admin": "tsx src/admin/mock-server.ts",
    "mock:admin:build": "npm run build && node dist/admin/mock-server.js",
    "qa:admin": "node scripts/admin-workspace-qa.mjs",
    "update:nanocrab": "node scripts/update-nanocrab.mjs",
    "migrate:nanocrab": "node scripts/migrate-nanoclaw-to-nanocrab.mjs",
    "deploy": "bash scripts/deploy.sh",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "mcp:smoke:mail": "tsx scripts/mcp-smoke.ts --mail",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:full": "bash scripts/setup-nanocrab.sh --all",
    "setup:resume": "bash scripts/setup-nanocrab.sh --resume",
    "setup:step": "bash scripts/setup-nanocrab.sh --step",
    "verify:signal:runtime": "bash scripts/verify-signal-runtime.sh",
    "auth": "tsx src/whatsapp-auth.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check:runtime": "node scripts/check-node-runtime.mjs",
    "pretest": "npm run check:runtime",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.10.0",
    "cron-parser": "5.5.0",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "grammy": "^1.39.3",
    "otpauth": "^9.5.0",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "suncalc": "^1.9.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20 <26"
  }
}
