ASSISTANT_HAS_OWN_NUMBER=

# Messaging channels. Leave unset for adapters you do not use.
TELEGRAM_BOT_TOKEN=
SIGNAL_PHONE_NUMBER=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=

# Startup notice sent directly to main owner channels after NanoCrab restarts.
# This is host-level status only; it does not wake the agent or trigger a reply.
NANOCRAB_STARTUP_NOTICE=true
NANOCRAB_STARTUP_NOTICE_TEXT=
NANOCRAB_STARTUP_NOTICE_MIN_INTERVAL_MS=300000

# Host-native coding runner timeout; defaults to CONTAINER_TIMEOUT.
CODING_JOB_RUNNER_TIMEOUT_MS=1800000

# Absolute path to the service user's Devin credential file. NanoCrab stats
# this file but never reads its contents. Owner must match the service UID and
# POSIX mode must be exactly 0600.
DEVIN_CREDENTIAL_PATH=/home/nanocrab/.config/devin/credentials.json

# Optional exact provider/model -> Devin CLI alias extensions. Built-ins are
# claude/claude-sonnet-4-6 -> claude-sonnet-4 and
# claude/claude-opus-4-6 -> claude-opus-4.6; they cannot be overridden.
DEVIN_CLI_MODEL_ALIASES_JSON={"claude/claude-haiku-4-5":"claude-haiku-4.5"}
