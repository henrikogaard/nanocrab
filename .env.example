ASSISTANT_HAS_OWN_NUMBER=

# Messaging channels. Leave unset for adapters you do not use.
TELEGRAM_BOT_TOKEN=
SIGNAL_PHONE_NUMBER=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=

# Startup notice sent directly to main owner channels after NanoCrab restarts.
# This is host-level status only; it does not wake the agent or trigger a reply.
NANOCRAB_STARTUP_NOTICE=true
NANOCRAB_STARTUP_NOTICE_TEXT=
NANOCRAB_STARTUP_NOTICE_MIN_INTERVAL_MS=300000
